<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SupportAssistant.Api\SupportAssistant.Api.csproj" />
  </ItemGroup>

  <!-- Shared contract fixtures and the example environment are read by tests, never copied by hand. -->
  <ItemGroup>
    <None Include="..\contracts\*.json" LinkBase="contracts" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\.env.example" Link="env.example" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
