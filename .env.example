# Copy to .env for local runs. .env is gitignored; never commit a real key.

# --- RAG service (Python) ---
# evidence_only: no LLM call, returns candidate sections. generative: requires OPENAI_API_KEY.
APP_MODE=evidence_only
# Evaluated setup: OpenAI's gpt-6-luna through OpenRouter; the OpenRouter key goes in OPENAI_API_KEY.
# Direct OpenAI instead: leave OPENAI_BASE_URL empty (= https://api.openai.com/v1), OPENAI_MODEL=gpt-6-luna.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-6-luna
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Full Hugging Face commit of EMBEDDING_MODEL; a different one needs the model checks rerun.
EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
# Relative paths resolve against src/rag_service, where the Python commands run. Docker Compose
# does not pass these three; the RAG image uses its own container paths.
KNOWLEDGE_DIR=../../data/knowledge
INDEX_PATH=../../var/index.sqlite3
MODEL_CACHE_DIR=../../var/models
TOP_K=4
# Empty = disabled until a threshold is measured on the development questions.
MIN_RETRIEVAL_SCORE=
LLM_TIMEOUT_SECONDS=25

# --- External API (.NET) ---
# Local process address of the RAG service; inside Docker Compose it is http://rag:8000.
RAG_SERVICE_URL=http://127.0.0.1:8000
RAG_TIMEOUT_SECONDS=45
